{
  "manifest_version": 3,
  "name": "APA 7 Citation Generator",
  "version": "1.0.0",
  "description": "Instantly generate an APA 7th Edition citation for the current webpage.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "index.html",
    "default_title": "Generate Citation"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
